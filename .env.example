# Required for Gemini story outline and narration.
GEMINI_API_KEY=

# Required when IMAGE_PROVIDER=hf_inference.
HF_API_KEY=

# Current model IDs; both can be changed without editing application code.
GEMINI_OUTLINE_MODEL=gemini-2.5-flash
GEMINI_STORY_MODEL=gemini-2.5-pro
STABLE_DIFFUSION_MODEL=runwayml/stable-diffusion-v1-5

# Use hf_inference for hosted Hugging Face inference, or diffusers for local generation.
IMAGE_PROVIDER=hf_inference
IMAGE_STEPS=25
IMAGE_TIMEOUT=180

# Optional: set a stable signing secret yourself for deployed environments.
# If blank, ComicCraft creates and stores a local secret in data/.session_secret.
SESSION_SECRET=

# Set true only when serving over HTTPS.
COOKIE_SECURE=false
